rules_version = '2';
// preview 전용 Portfolio 탭(2026-10-19, 전략 비교 묶음 2026-10-20) — Firestore 규칙 틀. 공개 저장소라 이메일은 자리표시자로 둔다.
// Firebase 콘솔 → Firestore → 규칙 탭에 붙여 넣고, 콘솔에서 OWNER_EMAIL만 내 Gmail 주소로 바꾼 뒤 게시한다
// (실제 이메일은 콘솔에만 있다 — 이 파일에는 넣지 않는다).
// 나만 쓰기: 그 계정 한 개가 Google 로그인으로 자기 문서만 읽고 쓴다.
//   users/{자기 uid}/portfolio/main          — 원칙·실제 자산·관심 종목(통째로 바꾸기)
//   users/{자기 uid}/portfolio/strategy_N    — 전략 비교 묶음(N = 1~99). 덧붙이기만:
//       만들 때 시작 스냅샷을 한 번 넣고(입금·시나리오는 비어 있게, lastKey는 ''), 그 뒤에는 입금 하나·시나리오 하나·끝내기
//       중 하나만 한 번에 더한다. 입금·시나리오를 더할 때는 새 키 이름을 lastKey에도 쓴다 — 규칙은 집합의 원소를 꺼낼 수
//       없어서, '더한 키가 정확히 lastKey 하나'인지로 새 값을 찾아 검사한다. 이미 있는 값은 바꾸거나 지울 수 없고, 기록 시각은 서버 시각이어야 한다. 끝낸 묶음은 더 쓸 수 없다.
//       문서 삭제는 막는다. (설계 pipeline/portfolio/STRATEGY_DESIGN.md 4·8절)
//   users/{자기 uid}/portfolio/trades        — 실제 매매 기록(2026-10-20). 덧붙이기만: 빈 문서로 만들고(entries {}, lastKey ''),
//       그 뒤에는 매매 하나 또는 취소 하나씩 더한다(새 키를 lastKey에도). 취소는 있는 매매 기록만 가리킨다. 기존 기록의 변경·삭제와 문서 삭제는 거부.
// 다른 계정·로그아웃 상태·다른 경로는 모두 거부.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email == 'OWNER_EMAIL'
        && request.auth.token.email_verified == true;
    }
    function isBundle(id) {
      return id.matches('strategy_[1-9][0-9]?');
    }
    function validSnapshot(s) {
      return s is map
        && s.keys().hasOnly(['date', 'holdings', 'cash', 'holdOnly', 'createdAt'])
        && s.keys().hasAll(['date', 'holdings', 'cash', 'holdOnly', 'createdAt'])
        && s.date is string && s.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && s.holdings is map && s.holdings.size() <= 100
        && s.cash is number && s.cash >= 0
        && s.holdOnly is list && s.holdOnly.size() <= 100
        && s.createdAt == request.time;
    }
    function validNew(d) {
      return d.keys().hasOnly(['snapshot', 'deposits', 'scenarios', 'lastKey'])
        && d.keys().hasAll(['snapshot', 'deposits', 'scenarios', 'lastKey'])
        && validSnapshot(d.snapshot)
        && d.deposits == {} && d.scenarios == {} && d.lastKey == '';
    }
    // 지도 o → n 이 키 k 하나만 더하고 나머지는 그대로인가
    function addsOnly(o, n, k) {
      return n is map && k is string && k.size() >= 1 && k.size() <= 40
        && n.diff(o).addedKeys().hasOnly([k]) && n.diff(o).addedKeys().size() == 1
        && n.diff(o).removedKeys().size() == 0
        && n.diff(o).changedKeys().size() == 0;
    }
    // 취소는 이미 있는 기록(취소 기록이 아닌 것)만 가리킬 수 있다. 반영일 장 시작 뒤 취소는 계산(엔진)이 무시하고 화면도 '무시됨'으로 보인다
    // (규칙은 거래일 달력을 계산할 수 없다).
    function validCancel(e, o) {
      return e.keys().hasOnly(['cancels', 'recordedAt']) && e.cancels is string && e.cancels.size() <= 40
        && e.cancels in o && !('cancels' in o[e.cancels]);
    }
    function validDeposit(e, o) {
      return e is map && e.recordedAt == request.time
        && ((e.keys().hasOnly(['amount', 'recordedAt']) && e.amount is number && e.amount > 0 && e.amount <= 10000000)
          || validCancel(e, o));
    }
    function validScenario(e) {
      return e is map
        && e.keys().hasOnly(['name', 'strategy', 'params', 'createdAt', 'engineVersion'])
        && e.name is string && e.name.size() >= 1 && e.name.size() <= 40
        && e.strategy in ['B', 'C', 'D', 'custom']
        && e.params is map && e.params.keys().hasOnly(['buyTiers', 'sellFraction', 'splitWeeks', 'cashReserve'])
        && e.engineVersion is string && e.engineVersion.size() <= 40
        && e.createdAt == request.time;
    }
    function validAppend(o, n) {
      return !('closed' in o)
        && ((n.diff(o).affectedKeys().hasOnly(['deposits', 'lastKey']) && addsOnly(o.deposits, n.deposits, n.lastKey)
              && n.deposits.size() <= 300 && validDeposit(n.deposits[n.lastKey], o.deposits))
          || (n.diff(o).affectedKeys().hasOnly(['scenarios', 'lastKey']) && addsOnly(o.scenarios, n.scenarios, n.lastKey)
              && n.scenarios.size() <= 20 && validScenario(n.scenarios[n.lastKey]))
          || (n.diff(o).affectedKeys().hasOnly(['closed']) && n.closed is map
              && n.closed.keys().hasOnly(['reason', 'at']) && n.closed.reason == 'correction' && n.closed.at == request.time));
    }

    function validTrade(e, o) {
      return e is map && e.recordedAt == request.time
        && ((e.keys().hasOnly(['date', 'ticker', 'side', 'qty', 'price', 'recordedAt'])
              && e.date is string && e.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
              && e.ticker is string && e.ticker.matches('[A-Z][A-Z0-9.-]{0,9}')
              && e.side in ['buy', 'sell']
              && e.qty is number && e.qty > 0 && e.qty <= 10000000
              && e.price is number && e.price > 0 && e.price <= 10000000)
          || validCancel(e, o));
    }

    match /users/{uid}/portfolio/trades {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.keys().hasOnly(['entries', 'lastKey'])
        && request.resource.data.entries == {} && request.resource.data.lastKey == '';
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entries', 'lastKey'])
        && addsOnly(resource.data.entries, request.resource.data.entries, request.resource.data.lastKey)
        && request.resource.data.entries.size() <= 3000
        && validTrade(request.resource.data.entries[request.resource.data.lastKey], resource.data.entries);
      allow delete: if false;
    }
    match /users/{uid}/portfolio/main {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/portfolio/{bundle} {
      allow read: if isOwner(uid) && isBundle(bundle);
      allow create: if isOwner(uid) && isBundle(bundle) && validNew(request.resource.data);
      allow update: if isOwner(uid) && isBundle(bundle) && validAppend(resource.data, request.resource.data);
      allow delete: if false;
    }
  }
}
